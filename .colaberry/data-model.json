{
  "schema_version": 1,
  "note": "Proposed data model derived from plan.json requirements. Not built.",
  "tables": [
    {
      "name": "Customer",
      "requirements": [
        "REQ-002"
      ],
      "fields": [
        "id",
        "name",
        "email",
        "phone",
        "contact_verified_at"
      ],
      "relations": "Has many Bookings"
    },
    {
      "name": "Booking",
      "requirements": [
        "REQ-001",
        "REQ-003",
        "REQ-004"
      ],
      "fields": [
        "id",
        "customer_id",
        "service",
        "starts_at",
        "status (draft / flagged / approved / confirmed)",
        "review_reason"
      ],
      "relations": "Belongs to Customer; has many Confirmations"
    },
    {
      "name": "Confirmation",
      "requirements": [
        "REQ-004",
        "REQ-005"
      ],
      "fields": [
        "id",
        "booking_id",
        "approved_by",
        "approved_at",
        "sent_at",
        "gmail_message_id"
      ],
      "relations": "Belongs to Booking"
    },
    {
      "name": "AvailabilitySlot",
      "requirements": [
        "REQ-003"
      ],
      "fields": [
        "id",
        "starts_at",
        "ends_at",
        "certainty (known / uncertain)"
      ],
      "relations": "Referenced by Booking checks"
    }
  ]
}